# EditorConfig · https://editorconfig.org
# 统一跨编辑器的基础风格,与 Prettier/项目约定一致

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 中行尾两空格有语义(换行),不裁剪
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
